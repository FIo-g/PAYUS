{
  "name": "sejongpay-backend",
  "version": "1.0.0",
  "description": "SejongPay 고려대학교 세종캠퍼스 QR 결제 플랫폼 백엔드",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": ["**/src/__tests__/**/*.test.js"],
    "setupFiles": ["./src/__tests__/setup/env.js"],
    "moduleNameMapper": {
      "^.+/models/(.+\\.model)$": "<rootDir>/src/__tests__/helpers/models/$1"
    }
  }
}
