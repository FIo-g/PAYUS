# ──────────────────────────────────────────────
# SejongPay Backend — 환경 변수 예시
# 이 파일을 복사해 .env로 저장한 뒤 실제 값을 채우세요.
# cp .env.example .env
# ──────────────────────────────────────────────

# 실행 환경: development | production | test
NODE_ENV=development

# Express 서버 포트
PORT=4000

# MongoDB 연결 URI (Atlas M0 Free Tier 권장)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sejongpay?retryWrites=true&w=majority

# JWT Access Token 서명 비밀키 (64자 이상 랜덤 문자열)
JWT_ACCESS_SECRET=change_me_access_secret_64chars_or_more_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Refresh Token 서명 비밀키 (64자 이상 랜덤 문자열, Access와 달라야 함)
JWT_REFRESH_SECRET=change_me_refresh_secret_64chars_or_more_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Access Token 만료 시간 (예: 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token 만료 시간 (예: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# 동적 QR HMAC-SHA256 서명 비밀키 (64자 이상 랜덤 문자열)
HMAC_QR_SECRET=change_me_hmac_qr_secret_64chars_or_more_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS 허용 오리진 (쉼표 구분, 공백 없음)
ALLOWED_ORIGINS=http://localhost:5173,https://sejongpay.vercel.app

# 카카오 REST API 키 (가맹점 지도/주소 검색)
KAKAO_LOCAL_API_KEY=your_kakao_rest_api_key_here

# Firebase Cloud Messaging 서버 키 (푸시 알림)
FCM_SERVER_KEY=your_fcm_server_key_here
